# =====================================================================
# LUBA Platform — Environment Variables Template
# Copy relevant sections into backend/.env and frontend/.env for local
# dev. In production, set these as Render Environment Variables
# (and GitHub Secrets for CI) — never commit a real .env file.
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND (Render Web Service) — backend/.env
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Supabase project URL (safe to expose)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon key — used only for JWT-audience validation reference, safe
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase SERVICE ROLE key — SECRET. Backend only. Never log, never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT secret (Project Settings -> API -> JWT Secret) — used to verify tokens
SUPABASE_JWT_SECRET=your-jwt-secret-here

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Future: payment gateway (Phase 6+ extension point)
# PAYMENT_GATEWAY_SECRET_KEY=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Future: Telegram bot (extension point)
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------
# FRONTEND (Render Static Site) — frontend/.env
# Vite only exposes vars prefixed VITE_ to the client bundle.
# NEVER put the service role key or JWT secret here.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:4000/api/v1
